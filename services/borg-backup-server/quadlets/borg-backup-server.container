[Unit]
Description=Borg-Backup-Server
After=network-online.target
Wants=network-online.target

[Container]
Pod=borg-backup-server.pod

Image=docker.io/marcpope/borgbackupserver:latest

Volume=/var/lib/local_containers/borg-backup-server/:/var/bbs:Z
Volume=/mnt/backup:/mnt/backup:Z

Environment=SSH_PORT=22
Environment=APP_URL=https://borg-backup-server.tail044fe.ts.net
Environment=ADMIN_PASS=#S!%*RvSAtvva7@7RbpUaSMWMXQgD9Cf

AutoUpdate=registry

[Service]
Restart=always

[Install]
WantedBy=multi-user.target