[Unit]
Description=Borg-Backup-Server
After=network-online.target
Wants=network-online.target

[Container]
Pod=borg-backup-server.pod

Image=docker.io/marcpope/borgbackupserver:latest

Volume=/mnt/backup/bbs:/var/bbs:Z

Environment=SSH_PORT=22
Environment=APP_URL=https://borg-backup-server.tail044fe.ts.net
Environment=ADMIN_PASS=

AutoUpdate=registry

[Service]
Restart=always

[Install]
WantedBy=multi-user.target