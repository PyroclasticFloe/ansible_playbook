[Unit]
Description=homarr
After=network-online.target
Wants=network-online.target

[Container]
Pod=homarr.pod

Image=ghcr.io/homarr-labs/homarr:latest

Volume=/var/lib/local_containers/homarr/appdata:/appdata:Z

# Docker integration reaches the per-host socket proxies over the tailnet
# (DOCKER_HOSTNAMES/DOCKER_PORTS in homarr.env), so no local socket is mounted.
EnvironmentFile=/etc/local_containers/homarr/homarr.env

AutoUpdate=registry

[Service]
Restart=always

[Install]
WantedBy=multi-user.target
