[Unit]
Description=Open-Computer
StartLimitIntervalSec=30
StartLimitBurst=10


[Container]
Pod=open-computer.pod

User=1000:1000

Image=ghcr.io/open-webui/computer:latest

Volume=/var/lib/local_containers/open-computer/data:/data:rw,Z
Volume=/home/aria/ai/ow-computer:/home/cptr:rw,Z
Volume=/home/aria/ai/outbox:/home/cptr/outbox:rw,Z
Volume=/home/aria/inbox:/home/cptr/inbox:ro,Z

AutoUpdate=registry

[Service]
Restart=always
RestartSec=5