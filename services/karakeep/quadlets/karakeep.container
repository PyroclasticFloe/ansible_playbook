[Unit]
Description=Bookmark Management
StartLimitIntervalSec=30
StartLimitBurst=10

[Container]
Pod=karakeep.pod
ContainerName=karakeep

Image=ghcr.io/karakeep-app/karakeep:latest

Volume=/var/lib/local_containers/karakeep/data:/data:rw,z

EnvironmentFile=/etc/local_containers/karakeep/karakeep.env
Environment=DATA_DIR=/data
Environment=MEILI_ADDR=http://kara-meilisearch:7700
Environment=NEXTAUTH_URL=http://localhost:3000
Environment=BROWSER_WEB_URL: http://kara-chrome:9222

AutoUpdate=registry

[Service]
Restart=unless-stopped
RestartSec=5